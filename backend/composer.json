{
  "name": "qemmat-almajd/backend",
  "type": "project",
  "description": "Qemmat Al Majd Business Services API",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0",
    "laravel/sanctum": "^4.0",
    "filament/filament": "^3.2",
    "spatie/laravel-permission": "^6.0",
    "league/flysystem-aws-s3-v3": "^3.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.13",
    "nunomaduro/collision": "^8.0",
    "mockery/mockery": "^1.6",
    "nunomaduro/larastan": "^2.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": { "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" } },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "scripts": { "post-autoload-dump": ["@php artisan package:discover --ansi"], "test": "@php artisan test", "lint": "pint --test" },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "audit": {
      "block-insecure": false
    }
  }
}
